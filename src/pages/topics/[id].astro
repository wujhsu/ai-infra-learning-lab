---
import {getCollection,render} from 'astro:content';
import Lesson from '../../layouts/Lesson.astro';
export async function getStaticPaths(){return(await getCollection('topics')).map(entry=>({params:{id:entry.id},props:{entry}}));}
const {entry}=Astro.props;const {Content,headings}=await render(entry);
---
<Lesson kind="topics" entry={entry} headings={headings}><Content/></Lesson>
