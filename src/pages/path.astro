---
import Base from '../layouts/Base.astro';import {asset,reading,projects} from '../data/curriculum';import type {Project} from '../data/curriculum';
const span=(p:Project)=>{const first=reading.find(x=>x.id===p.chapters[0])!.order,last=reading.find(x=>x.id===p.chapters[p.chapters.length-1])!.order;return first===last?`第 ${first} 章`:`第 ${first}–${last} 章`;};
const sections=(p:Project)=>p.phases.map(ph=>({title:ph.title,outcome:ph.outcome,items:ph.chapters.map(id=>reading.find(x=>x.id===id)!)}));
---
<Base title="课程：五个项目" active="path/"><div class="page-wrap"><header class="page-title"><span class="eyebrow">理解机制 · 实现验证 · 回到系统</span><h1>五个项目，把知识做成系统</h1><p>课程按项目组织：项目是主线，章节是完成它所需的模块。顺着读或按项目学都可以；重点是能解释、改动代码和验证结果。</p></header>{projects.map((p)=><section class="path-stage" id={p.id}><header><small>{p.label} · {span(p)}</small><h2>{p.title}</h2><p>{p.outcome}</p><p class="path-lab"><span class="path-lab-status">{p.labStatus}</span><a href={asset(`projects/${p.id}/`)}>进入项目实践 →</a></p></header>{sections(p).map(ph=><div class="path-phase">{p.phases.length>1&&<><h3>{ph.title}</h3><p>{ph.outcome}</p></>}<ol>{ph.items.map(c=><li><a data-course={`read/${c.id}`} data-title={c.title} href={asset(`read/${c.id}/`)}><span>{String(c.order).padStart(2,'0')}</span>{c.title}<b aria-hidden="true">→</b></a></li>)}</ol></div>)}</section>)}</div></Base>
