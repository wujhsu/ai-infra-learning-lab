---
import Base from '../layouts/Base.astro';import {asset,reading,stages} from '../data/curriculum';
---
<Base title="完整学习路径" active="path/"><div class="page-wrap"><header class="page-title"><span class="eyebrow">原理 → 实现 → 测量 → 系统</span><h1>沿着依赖，把知识接起来</h1><p>第一次从模型计算开始。每个阶段有明确成果；重点不是读完多少篇，而是能够解释、改动代码和验证结果。</p></header>{stages.map((s)=><section class="path-stage" id={s.id}><header><small>阶段 {s.id.split('-')[1]}</small><h2>{s.title}</h2><p>{s.outcome}</p></header><ol>{s.chapters.map(id=>{const c=reading.find(x=>x.id===id)!;return <li><a data-course={`read/${id}`} data-title={c.title} href={asset(`read/${id}/`)}><span>{String(c.order).padStart(2,'0')}</span>{c.title}<b aria-hidden="true">→</b></a></li>})}</ol></section>)}</div></Base>
