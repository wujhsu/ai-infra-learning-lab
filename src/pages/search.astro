---
import Base from '../layouts/Base.astro';import {asset} from '../data/curriculum';
---
<Base title="搜索知识"><div class="page-wrap search-box"><header class="page-title"><span class="eyebrow">找到问题所在的位置</span><h1>搜索概念、问题和讲义</h1><p>试试「首字延迟」「KV Cache」「ResourceClaim」或「通信」。</p></header><div id="search" data-base={import.meta.env.BASE_URL}></div><noscript><p>全文搜索需要 JavaScript。你也可以从<a href={asset('glossary/')}>术语索引</a>或<a href={asset('path/')}>学习路径</a>浏览。</p></noscript><div class="search-fallback"><a href={asset('glossary/')}>浏览中英文术语 →</a> · <a href={asset('sessions/')}>查看会议与讲义索引 →</a></div></div><script is:inline>const base=document.querySelector('#search').dataset.base;const style=document.createElement('link');style.rel='stylesheet';style.href=base+'pagefind/pagefind-ui.css';document.head.append(style);const script=document.createElement('script');script.src=base+'pagefind/pagefind-ui.js';script.onload=()=>{new PagefindUI({element:'#search',showSubResults:true,baseUrl:base,translations:{placeholder:'输入你想理解的概念…',zero_results:'没有找到相关内容，请尝试英文缩写或中文名称。'}});const suggestions=document.createElement('div');suggestions.className='concept-matches';suggestions.hidden=true;suggestions.setAttribute('aria-live','polite');document.querySelector('.pagefind-ui__drawer').before(suggestions);document.querySelector('#search').addEventListener('input',event=>{const q=event.target.value?.trim().toLowerCase();suggestions.replaceChildren();suggestions.hidden=true;if(!q||q.length<2)return;const matches=window.LEARNING_GLOSSARY.filter(t=>[t.name,t.full,...t.aliases].some(v=>v.toLowerCase().includes(q))).slice(0,4);if(!matches.length)return;suggestions.hidden=false;const title=document.createElement('strong');title.textContent='从这个概念开始学';suggestions.append(title);for(const t of matches){const a=document.createElement('a');a.href=base+'learn/'+t.lesson+'/';a.textContent=t.name+' · '+t.full+' →';suggestions.append(a);}});};script.onerror=()=>{document.querySelector('#search').textContent='搜索索引暂时不可用，请使用下方术语或课程目录。'};document.head.append(script);</script></Base>
