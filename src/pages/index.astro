---
import Base from '../layouts/Base.astro';import {modules,titles,asset} from '../data/curriculum';
---
<Base title="从问题出发，理解 AI 基础设施"><div class="page-wrap"><div class="home-topline"><span>你的 AI Infra 学习工作台</span><span><strong data-completed>0</strong> / 24 节已阅读</span></div><div class="home-grid"><section class="continue-panel"><span class="eyebrow">从一次请求开始</span><h1 data-continue-title>一个请求，怎样到达 GPU？</h1><p>先看清系统，再理解每一层。遇到不懂的概念就地展开，带着问题看图，然后在真实环境里验证。</p><a class="button" data-continue href={asset('learn/01-request/')}>进入学习 <span>→</span></a><div class="request-map" aria-label="请求经过的组件"><span>客户端</span><i>→</i><span>推理引擎</span><i>→</i><span>GPU</span><i>→</i><span>Token</span></div></section><section class="question-panel"><span class="eyebrow">也可以带着问题进入</span><h2>你现在想弄明白什么？</h2>{[['07-latency','为什么首个 token 很慢？','拆开排队、Prefill 与流式输出'],['09-kv-memory','显存为什么不够用？','算清 KV，再理解分页与并发'],['18-lws','Pod 跑起来，服务就健康了吗？','从单个进程走到整组检查']].map(([id,title,sub],i)=><a class="question-link" href={asset(`learn/${id}/`)}><b>0{i+1}</b><div>{title}<small>{sub}</small></div></a>)}</section></div><div class="section-heading"><h2>沿着系统，一层层理解</h2><a href={asset('path/')}>查看完整学习路径 →</a></div><div class="module-grid">{modules.map((m,i)=><a class="module-card" href={asset(`path/#module-${i+1}`)}><span class="module-number">MODULE 0{i+1} / 3 节</span><h3>{m.title}</h3><p>{m.subtitle}</p></a>)}</div><div class="feature-strip"><div><a href={asset('sessions/')}>回到会议证据 ↗</a><p>12 场记录、214 页讲义索引，精选原图配中文拆解。</p></div><div><a href={asset('topics/')}>继续向下钻 ↗</a><p>KernelAgent、PyTorch、优化器、同步语义和高级拓扑。</p></div><div><a href={asset('notebook/')}>留下自己的理解 ↗</a><p>保存笔记、书签与待复习项，随时导出备份。</p></div></div><div hidden>{titles.map(([id,title])=><span data-course={`learn/${id}`} data-title={title}/>)}</div></div></Base>
