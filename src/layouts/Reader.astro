---
import {getCollection} from 'astro:content';
import Base from './Base.astro';
import sources from '../data/sources.json';
import glossary from '../data/glossary.json';
import {asset,reading,stages} from '../data/curriculum';

type ReaderKind='read'|'projects'|'code'|'advanced';
type NavItem={id:string;title:string;order:number;url:string;stage?:number};
type NavGroup={id:string;title:string;outcome:string;items:NavItem[]};

const {entry,headings=[],kind='read'}=Astro.props as {entry:any;headings:any[];kind?:ReaderKind};
const d=entry.data;
const isChapter=kind==='read';
const labels:Record<ReaderKind,string>={read:'课程',projects:'实践项目',code:'源码阅读',advanced:'进阶研究'};
const label=labels[kind];
const collectionEntries=isChapter?[]:kind==='projects'
 ? await getCollection('projects')
 : kind==='code'
  ? await getCollection('code')
  : await getCollection('advanced');
const items:NavItem[]=isChapter
 ? reading.map(item=>({...item,url:asset(`read/${item.id}/`)}))
 : collectionEntries.sort((a,b)=>a.data.order-b.data.order).map(item=>({id:item.id,title:item.data.title,order:item.data.order,url:asset(`${kind}/${item.id}/`)}));
const index=items.findIndex(item=>item.id===entry.id);
const position=index+1;
const prev=items[index-1];
const next=items[index+1]||(isChapter?{id:'projects',title:'进入实践项目',order:items.length+1,url:asset('projects/')}:undefined);
const stage=isChapter?stages[(items[index]?.stage||d.stage)-1]:undefined;
const groups:NavGroup[]=isChapter
 ? stages.map(s=>({id:s.id,title:`阶段 ${s.id.split('-')[1]} · ${s.title}`,outcome:s.outcome,items:s.chapters.map(id=>items.find(item=>item.id===id)!).filter(Boolean)}))
 : [{id:kind,title:label,outcome:`共 ${items.length} 篇，按建议顺序排列`,items}];
const outline=headings.filter((heading:any)=>heading.depth===2).map((heading:any)=>({slug:heading.slug,text:heading.text}));
const outlineWithCheck=[...outline,{slug:'self-check',text:'换个情况，解释一次'}];
const categoryHref=asset(isChapter?'path/':`${kind}/`);
const unit=isChapter?'章':'篇';
---
<Base title={d.title} description={d.description} active={isChapter?'path/':kind+'/'}>
<div class="reader" data-record={`${kind}/${entry.id}`} data-revision={d.revision}>
 <nav class="reader-crumbs" aria-label="面包屑" data-pagefind-ignore>
  <a href={categoryHref}>{label}</a><span aria-hidden="true">/</span>
  {isChapter&&stage&&<><a href={asset(`path/#${stage.id}`)}>阶段 {stage.id.split('-')[1]} · {stage.title}</a><span aria-hidden="true">/</span></>}
  <span aria-current="page">第 {position} {unit}</span>
 </nav>
 <header class="reader-head"><h1>{d.title}</h1><p>{d.description}</p><div class="reader-meta"><span>约 {d.minutes} 分钟 · 阅读估计</span><a data-resume hidden>回到上次读到的地方 →</a></div></header>
 <nav class="reader-switcher" aria-label={`${label}切换`} data-pagefind-ignore>
  {prev?<a class="reader-step" href={prev.url} aria-label={`上一${unit}：${prev.title}`} title={`上一${unit}：${prev.title}`}><span aria-hidden="true">←</span></a>:<button class="reader-step is-disabled" type="button" disabled aria-label={`已经是第一${unit}`}>←</button>}
  <button class="reader-menu-button" type="button" data-reader-menu-open aria-haspopup="dialog" aria-controls="reader-nav-dialog" aria-expanded="false" title={d.title}>
   <span>第 {position} / {items.length} {unit}</span><strong>{d.title}</strong><small data-current-section>{isChapter?'本章导读':'文章导读'}</small>
  </button>
  <a class="reader-menu-fallback" href={categoryHref} title={d.title}><span>第 {position} / {items.length} {unit}</span><strong>{d.title}</strong><small>打开完整{label}</small></a>
  {next?<a class="reader-step" href={next.url} aria-label={`下一步：${next.title}`} title={`下一步：${next.title}`}><span aria-hidden="true">→</span></a>:<button class="reader-step is-disabled" type="button" disabled aria-label={`已经是最后一${unit}`}>→</button>}
 </nav>
 <dialog id="reader-nav-dialog" class="reader-nav-dialog" aria-labelledby="reader-nav-title" data-pagefind-ignore>
  <form method="dialog"><button class="close" aria-label="关闭章节选择器">×</button></form>
  <header><span class="eyebrow">快速切换</span><h2 id="reader-nav-title">{label}</h2><p>当前是第 {position} / {items.length} {unit}</p></header>
  <div class="reader-menu-scroll">
   {groups.map(group=><details class="reader-menu-group" open={!isChapter||group.id===stage?.id}>
    <summary><span>{group.title}</span><small>{group.outcome}</small></summary>
    <ol>{group.items.map(item=><li><a href={item.url} data-course={`${kind}/${item.id}`} data-menu-current={item.id===entry.id||undefined} aria-current={item.id===entry.id?'page':undefined}><span>{String(item.order).padStart(2,'0')}</span><strong>{item.title}</strong></a></li>)}</ol>
   </details>)}
  </div>
 </dialog>
 <details class="reader-toc" open>
  <summary><span>本章路标</span><small>{outlineWithCheck.length} 节</small></summary>
  <nav aria-label="本章目录"><ol>{outlineWithCheck.map((item,index)=><li><a href={`#${item.slug}`} data-toc-link={item.slug} data-section-title={item.text}><span>{String(index+1).padStart(2,'0')}</span>{item.text}</a></li>)}</ol></nav>
 </details>
 <article class="prose reader-prose" data-pagefind-body data-pagefind-weight={isChapter?2:1}><p class="sr-only" data-pagefind-weight="8">概念检索：{d.terms.map((id:string)=>{const t=glossary.find(x=>x.id===id);return t?[t.name,t.full,...t.aliases].join(' / '):''}).join('；')}</p>
 {d.prerequisites.length>0&&<aside class="prerequisite-note" aria-label="承接前文"><strong>承接前文</strong><p>先确认这些内容仍能解释：</p><ul>{d.prerequisites.map((id:string)=><li><a href={asset(`read/${id}/`)}>{reading.find(c=>c.id===id)?.title||id}</a></li>)}</ul></aside>}
 {d.environment&&<p class="environment-note">实验环境：{d.environment}。{d.verification}</p>}
 <slot/>
 <section class="understanding" id="self-check"><h2>换个情况，你能解释吗？</h2><p>{d.question}</p><details><summary>展开参考思路</summary><p>{d.answer}</p></details></section>
 {d.project&&<a class="project-link" href={asset(`projects/${d.project}/`)}>把机制带到项目里 →</a>}
 <p class="chapter-bridge">{d.bridge}</p>
 <details class="reader-evidence"><summary>来源、版本与验证状态</summary><p><b>内容状态：</b>待真实试读。{d.verification}。教学计算不代表真实模型的性能；硬件结果以对应实验记录为准。</p>{d.sources.map((id:string)=>{const s=sources.find(x=>x.id===id);return s&&<div class="source-item"><a href={s.url} target="_blank" rel="noopener">{s.title} ↗</a><small>{s.kind} · {s.version} · 核验 {s.checked}</small></div>})}</details>
 <details class="reader-notes" id="learning-notes"><summary>笔记、书签与学习状态</summary><div class="status-checks">{[['read','已阅读'],['understood','能解释'],['lab','实验完成'],['bookmark','加入书签'],['review','需要复习']].map(([field,text])=><label><input type="checkbox" data-record-field={field}/>{text}</label>)}</div><label for="lesson-note">记下你的解释，或卡住的那一句</label><textarea id="lesson-note" data-note rows="4" placeholder="先用自己的话解释，再记下仍不确定的地方。"></textarea><small data-save-status>仅保存在当前浏览器，可导出备份。</small></details>
 <nav class="lesson-pager" aria-label="前后文章">{prev?<a href={prev.url}><small>回顾上一{unit}</small>{prev.title}</a>:<span/>}{next?<a href={next.url}><small>继续顺着读</small>{next.title} →</a>:<span/>}</nav>
 </article>
</div>
</Base>
