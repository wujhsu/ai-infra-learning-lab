---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import glossary from '../data/glossary.json';
import {asset} from '../data/curriculum';
const {title,description='面向初学者的 AI Infra 交互教材：理解机制、观察系统、动手验证。',active=''}=Astro.props;
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#163c68"/><title>{title} · AI Infra 学习实验室</title><link rel="icon" href={asset('favicon.svg')} type="image/svg+xml"/><link rel="canonical" href={new URL(Astro.url.pathname,Astro.site)}/><script is:inline>try{const s=JSON.parse(localStorage.getItem('ai-infra-learning:v1')||'{}').settings;if(s){document.documentElement.dataset.theme=s.theme;document.documentElement.style.setProperty('--reading-size',s.size+'px');document.documentElement.style.setProperty('--reading-line',s.line);}}catch{}</script></head>
<body><a class="skip" href="#main">跳到正文</a><header class="header"><a class="brand" href={asset('')} aria-label="AI Infra 学习实验室首页"><span class="brand-icon">i<span>∕</span></span><span>AI Infra<small>学习实验室</small></span></a><nav aria-label="主导航">{[['path/','学习路径'],['topics/','深入专题'],['labs/','动手实验'],['sessions/','会议资料']].map(([path,label])=><a class:list={{active:active===path}} href={asset(path)}>{label}</a>)}</nav><div class="header-tools"><a class="icon-button" href={asset('search/')} aria-label="搜索知识">⌕<span>搜索</span></a><a class="icon-button" href={asset('notebook/')} aria-label="我的学习记录">▤<span>学习记录</span></a><button class="icon-button" data-settings aria-label="阅读设置">Aa</button></div></header>
<main id="main"><slot/></main><footer class="footer"><span>AI Infra 学习实验室</span><p>来自 KubeCon China 2026 的问题，回到真实系统中理解。</p><a href={asset('sources/')}>资料与版本</a><a href={asset('glossary/')}>术语索引</a><a href="https://github.com/wujhsu/ai-infra-learning-lab">GitHub</a></footer>
<dialog id="term-dialog" class="term-dialog"><form method="dialog"><button class="close" aria-label="关闭术语解释">×</button></form><span class="eyebrow">就地补课</span><h2 data-term-title></h2><p data-term-full class="muted"></p><p data-term-definition></p><div class="explain-box"><b>举个例子</b><p data-term-example></p></div><p data-term-confused></p><a data-term-link>进一步理解 →</a></dialog>
<dialog id="foundation-dialog" class="reading-drawer"><form method="dialog"><button class="close" aria-label="关闭基础补课">×</button></form><span class="eyebrow">补上这一块，再回到原问题</span><h2>数学与软件基础</h2><h3>形状 → 元素 → 字节</h3><p>[2, 3] 有 6 个元素；每元素 2 字节，则原始数据占 12 字节。矩阵 [m,k] 与 [k,n] 相乘得到 [m,n]，中间维度必须一致。</p><h3>容量不等于带宽</h3><p>容量表示能存多少，带宽表示每秒能搬多少。1 GB = 10⁹ 字节，1 GiB = 2³⁰ 字节；搬运时间约为数据量除以有效带宽。</p><h3>容器与镜像</h3><p>镜像是应用文件和依赖的模板，容器是运行实例，通常共享宿主内核。镜像内有 CUDA 库不代表宿主驱动已安装。</p><h3>异步执行与测量</h3><p>CPU 发出 GPU 工作后可能立即返回。测函数发起时间不等于设备完成时间，需要按实验口径同步或使用设备事件。</p><a href={asset('foundations/')}>阅读完整基础补课：Softmax、网络、分位数等 →</a><p class="muted">关闭此侧栏会回到原来的阅读位置。</p></dialog>
<dialog id="settings-dialog"><form method="dialog"><button class="close" aria-label="关闭阅读设置">×</button></form><h2>按你的节奏阅读</h2><label>外观<select data-pref="theme"><option value="light">浅色</option><option value="dark">深色</option></select></label><label>正文字号<select data-pref="size"><option value="16">16 px</option><option value="18">18 px</option><option value="20">20 px</option><option value="22">22 px</option></select></label><label>行距<select data-pref="line"><option value="1.7">紧凑</option><option value="1.9">舒适</option><option value="2.1">宽松</option></select></label><button class="button" data-focus>切换专注阅读</button></dialog>
<dialog id="image-dialog" class="image-dialog"><form method="dialog"><button class="close" aria-label="关闭图片">×</button></form><div class="image-toolbar"><button data-image-scale="-" aria-label="缩小图片">−</button><button data-image-scale="+" aria-label="放大图片">＋</button><a data-original target="_blank" rel="noopener">打开原图 ↗</a></div><div class="image-scroll"><img data-large-image alt=""/></div><p data-image-caption></p></dialog>
<p class="toast" role="status" id="toast" hidden></p>
<script is:inline define:vars={{glossary,base:import.meta.env.BASE_URL}}>window.LEARNING_GLOSSARY=glossary;window.LEARNING_BASE=base;</script>
<script>import '../lib/client';</script>
</body></html>
