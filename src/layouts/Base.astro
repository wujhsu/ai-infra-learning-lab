---
import '../styles/global.css';import '../styles/reader.css';import 'katex/dist/katex.min.css';
import glossary from '../data/glossary.json';import {asset} from '../data/curriculum';
const {title,description='从模型计算到训练、推理与平台工程。连续讲解、可运行实验和源码阅读。',active=''}=Astro.props;
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#1c504c"/><title>{title} · AI Infra 系统学习库</title><link rel="icon" href={asset('favicon.svg')} type="image/svg+xml"/><link rel="canonical" href={new URL(Astro.url.pathname,Astro.site)}/><script is:inline>document.documentElement.classList.add('js');const dark=matchMedia('(prefers-color-scheme: dark)').matches;let theme='auto';try{const s=JSON.parse(localStorage.getItem('ai-infra-library:v2')||'{}').settings;if(s){theme=['light','dark','auto'].includes(s.theme)?s.theme:'auto';document.documentElement.style.setProperty('--reading-size',s.size+'px');document.documentElement.style.setProperty('--reading-line',s.line);}}catch{}document.documentElement.dataset.theme=theme==='auto'?(dark?'dark':'light'):theme;</script></head>
<body><a class="skip" href="#main">跳到正文</a><header class="header"><a class="brand" href={asset('')}>AI Infra<span>系统学习库</span></a><nav aria-label="主导航">{[['path/','课程'],['projects/','项目'],['code/','源码'],['advanced/','进阶']].map(([path,label])=><a class:list={{active:active===path}} href={asset(path)}>{label}</a>)}</nav><div class="header-tools"><button class="nav-toggle" data-nav-open aria-haspopup="dialog" aria-controls="site-nav-dialog" aria-expanded="false">菜单</button><a href={asset('search/')} aria-label="搜索知识">搜索</a><a href={asset('notebook/')} aria-label="我的学习记录">笔记</a><button data-settings aria-label="阅读设置">Aa</button></div></header>
<main id="main"><slot/></main><footer class="footer"><span>理解机制 · 实现验证 · 回到系统</span><a href={asset('glossary/')}>概念索引</a><a href={asset('sources/')}>官方资料</a><a href={asset('sessions/')}>会议参考</a><a href="https://github.com/wujhsu/ai-infra-learning-lab">GitHub</a></footer>
<dialog id="term-dialog" class="term-dialog" aria-labelledby="term-title"><form method="dialog"><button class="close" aria-label="关闭术语解释">×</button></form><span class="eyebrow">在这里理解这个词</span><h2 id="term-title" data-term-title></h2><p data-term-full class="muted"></p><p data-term-definition></p><div class="explain-box"><b>放回当前例子</b><p data-term-example></p></div><p data-term-confused class="muted"></p><div class="term-actions"><a data-term-link>回看完整讲解 →</a><button data-term-review>加入待复习</button></div></dialog>
<dialog id="settings-dialog" aria-labelledby="settings-title"><form method="dialog"><button class="close" aria-label="关闭阅读设置">×</button></form><h2 id="settings-title">按你的节奏阅读</h2><label>外观<select data-pref="theme"><option value="auto">跟随系统</option><option value="light">浅色</option><option value="dark">深色</option></select></label><label>正文字号<select data-pref="size"><option value="17">17 px</option><option value="18">18 px</option><option value="20">20 px</option><option value="22">22 px</option></select></label><label>行距<select data-pref="line"><option value="1.7">紧凑</option><option value="1.9">舒适</option><option value="2.1">宽松</option></select></label></dialog>
<dialog id="site-nav-dialog" class="site-nav-dialog" aria-labelledby="site-nav-title"><form method="dialog"><button class="close" aria-label="关闭菜单">×</button></form><h2 id="site-nav-title">导航</h2><nav aria-label="移动导航">{[['path/','课程'],['projects/','项目'],['code/','源码'],['advanced/','进阶']].map(([path,label])=><a class:list={{active:active===path}} href={asset(path)}>{label}</a>)}<a href={asset('glossary/')}>概念索引</a><a href={asset('search/')}>搜索</a><a href={asset('notebook/')}>笔记</a></nav></dialog>
<dialog id="image-dialog" class="image-dialog" aria-label="图片放大阅读"><form method="dialog"><button class="close" aria-label="关闭图片">×</button></form><div class="image-toolbar"><button data-image-scale="-" aria-label="缩小图片">−</button><button data-image-scale="+" aria-label="放大图片">＋</button><a data-original target="_blank" rel="noopener">打开原图 ↗</a></div><div class="image-scroll"><img data-large-image alt=""/></div><p data-image-caption></p></dialog>
<p class="toast" role="status" id="toast" hidden></p>
<script is:inline define:vars={{glossary,base:import.meta.env.BASE_URL}}>window.LEARNING_GLOSSARY=glossary;window.LEARNING_BASE=base;</script><script>import '../lib/client';</script>
</body></html>
