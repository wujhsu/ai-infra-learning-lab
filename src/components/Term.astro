---
import glossary from '../data/glossary.json';
import {asset} from '../data/curriculum';
const {id,label,context,example}=Astro.props;const t=glossary.find(x=>x.id===id);if(!t)throw new Error(`Unknown term ${id}`);
---
<a class="term" href={asset(`glossary/#${id}`)} data-term={id} data-context={context} data-example={example} aria-haspopup="dialog" aria-label={`解释 ${t.name}`}>{label||t.name}</a>
