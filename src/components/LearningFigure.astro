---
import {model,fullAttention,projections} from '../lib/toy-model';
const {kind}=Astro.props;
const fmt=(xs:number[])=>'['+xs.map(x=>Number(x.toFixed(4))).join(', ')+']';
const short=fullAttention([0,1])[1],p=projections(model.prompt);
const steps:Record<string,string[]>={generation:['文字先变成词表编号；还没有决定回答。','模型根据当前上下文给整个词表打分。','选择一个新 token，把它接回上下文。','再次计算下一个位置；遇到结束标记或长度上限停止。'],embedding:['先读 ID：0、1、2、3 是四个身份编号。','每个 ID 到同一张参数表中查出一行。','把四行排在一起，得到 [4,2] 的输入矩阵。','每一层继续转换这些数值；初始表示与上下文表示不同。'],attention:['从“是”的 Q 出发，分别读取两个位置的 K。','点积分别为 0 和 1；除以 √2 后为 0 和 0.7071。','Softmax 把得分变成约 0.3302 和 0.6698，二者相加为 1。','用权重乘 V 再相加：输出约 [0.6605, 0.6698]。'],cache:['第一次处理四个输入位置，建立四组 K/V。','根据最后位置的输出选出“首都”；此刻还没有“首都”的 K/V。','把“首都”送入模型，只为新增位置计算 Q/K/V。','新 Q 读取旧四组和新增一组 K/V；缓存现在包含五个位置。']};
const titles:Record<string,string>={generation:'一次只前进一步的生成循环',embedding:'同一段文字：从编号到数值表示',attention:'同一个例子：算出“是”位置的一次 Attention',cache:'从四个位置到五个位置：哪些保留，哪些新增'};
---
<figure class="learning-figure" data-learning-figure>
 <figcaption><span class="eyebrow">沿着同一个例子看</span><strong>{titles[kind]}</strong></figcaption>
 {kind==='generation'&&<><div class="token-ribbon" data-figure-region="0">{model.prompt.map(id=><span>{model.vocabulary[id]}<small>ID {id}</small></span>)}</div><div class="flow-arrow">↓ 当前上下文送入模型</div><div class="figure-node" data-figure-region="1">为词表中每个候选给出得分<br/><small>本例有 {model.vocabulary.length} 个候选</small></div><div class="flow-arrow">↓ 转成概率，再选择</div><div class="figure-node new-data" data-figure-region="2">本轮选择：首都 · ID 4</div><div class="loop-note" data-figure-region="3">↶ 接回输入：北京 → 是 → 中国 → 的 → <b>首都</b><br/>下一轮才能继续决定“。”</div></>}
 {kind==='embedding'&&<><div class="token-ribbon" data-figure-region="0">{model.prompt.map(id=><span>{model.vocabulary[id]}<small>ID {id}</small></span>)}</div><div class="flow-arrow">↓ 按编号查嵌入表</div><div class="figure-table" data-figure-region="1"><table><thead><tr><th>位置</th><th>token / ID</th><th>查到的向量</th></tr></thead><tbody>{model.prompt.map((id,i)=><tr><td>{i}</td><td>{model.vocabulary[id]} / {id}</td><td>{fmt(model.embeddings[id])}</td></tr>)}</tbody></table></div><div class="figure-node" data-figure-region="2">4 行 × 每行 2 个分量 = 8 个数<br/>形状 [4,2]；第二维是表示维度</div><div class="loop-note" data-figure-region="3">↓ 模型的各层继续加工 → 含上下文的表示 → 候选得分</div></>}
 {kind==='attention'&&<><div class="figure-node" data-figure-region="0">当前位置“是”：Q = [0,1]<br/>“北京”的 K = [1,0]；“是”的 K = [0,1]</div><div class="flow-arrow">↓ 对每个位置各算一个分数</div><div class="figure-node" data-figure-region="1">除以 √2 后的得分：{fmt(short.scores)}</div><div class="weight-bars" data-figure-region="2">{short.weights.map((w,i)=><div><span>{model.vocabulary[i]}</span><b style={`--weight:${w*100}%`}>{(w*100).toFixed(2)}%</b></div>)}</div><div class="figure-node new-data" data-figure-region="3">{short.weights[0].toFixed(4)} × [2,0] + {short.weights[1].toFixed(4)} × [0,1]<br/>= {fmt(short.output)}</div></>}
 {kind==='cache'&&<><div class="token-ribbon" data-figure-region="0">{model.prompt.map((id,i)=><span>{model.vocabulary[id]}<small>K {fmt(p.k[i])}<br/>V {fmt(p.v[i])}</small></span>)}</div><p class="figure-node" data-figure-region="1">采样选出“首都”<br/><small>生成了它的 ID ≠ 已经计算它的 K/V</small></p><div class="figure-node new-data" data-figure-region="2">新增“首都”：Q=[2,0] · K=[2,0] · V=[4,0]</div><div class="cache-strip" data-figure-region="3"><span>旧 K/V × 4<br/>保留并读取</span><b>＋</b><span class="new-data">新 K/V × 1<br/>本轮计算</span></div></>}
 <div class="figure-steps" aria-label="分步看图">{steps[kind].map((s,i)=><button type="button" data-figure-step={i} aria-pressed="false" aria-label={`第 ${i+1} 步：${s}`}>{i+1}</button>)}</div>
 <ol class="figure-explanations">{steps[kind].map((s,i)=><li data-figure-explanation={i}>{s}</li>)}</ol>
 <small class="muted">手工教学数据，不是真实模型预测。蓝色表示已有数据，绿色表示本轮新增或结果。所有步骤无需 JavaScript 也可阅读。</small>
</figure>
